diff --git a/src/export/calendar.csv.js b/src/export/calendar.csv.js
index 62cbcd1..89327bf 100644
--- a/src/export/calendar.csv.js
+++ b/src/export/calendar.csv.js
@@ -1,8 +1,13 @@
-export function formatCalendarDate(value) {
-  return new Date(value).toISOString().slice(0, 10);
+export function formatCalendarDate(value, locale = 'en-CA') {
+  return new Intl.DateTimeFormat(locale, {
+    year: 'numeric',
+    month: '2-digit',
+    day: '2-digit',
+    timeZone: 'UTC'
+  }).format(new Date(value));
 }
 
-export function exportCalendarCsv(events) {
-  const rows = events.map((event) => `${formatCalendarDate(event.date)},${event.title}`);
+export function exportCalendarCsv(events, locale = 'en-CA') {
+  const rows = events.map((event) => `${formatCalendarDate(event.date, locale)},${event.title}`);
   return ['date,title', ...rows].join('\n');
 }
